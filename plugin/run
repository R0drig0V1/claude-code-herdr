#!/bin/sh
# Cross-platform launcher for the multi-agent-herdr hooks and scripts (macOS, Linux, Windows
# through Git Bash). Every hook in hooks.json and every plugin script a skill runs goes
# through it:
#
#   "${CLAUDE_PLUGIN_ROOT}/run" [--hook] <script> [args...]
#
# <script> is a path relative to the plugin root (hooks/guard-main-bash.py,
# scripts/project-config.py) or an absolute path. The launcher:
#
# - normalises the plugin root: on Windows ${CLAUDE_PLUGIN_ROOT} can arrive with backslashes
#   (C:\Users\...); they become forward slashes, which Git Bash, git and Python all accept,
#   and CLAUDE_PLUGIN_ROOT (this plugin root when unset) is exported in that form;
# - picks the interpreter instead of relying on the shebang and the exec bit (Windows has
#   neither): `.py` runs with Python 3.9+ (lib/python.sh: python3, python or py), `.sh` with
#   bash, anything else directly.
#
# With --hook a missing Python allows the call (exit 0, a note on stderr): the guards fail
# open, they must never wedge a session. Without it the exit code is 127.
#
# The file has no extension on purpose: Claude Code on Windows prefixes commands ending in
# `.sh` with `bash`, which can resolve to WSL's bash instead of Git Bash.

hook=""
if [ "${1:-}" = "--hook" ]; then hook=1; shift; fi
script="${1:?usage: run [--hook] <script> [args...]}"
shift

here=$(printf '%s' "$0" | tr '\\' '/')
root=$(CDPATH='' cd -- "$(dirname -- "$here")" && pwd)
CLAUDE_PLUGIN_ROOT=$(printf '%s' "${CLAUDE_PLUGIN_ROOT:-$root}" | tr '\\' '/')
export CLAUDE_PLUGIN_ROOT

script=$(printf '%s' "$script" | tr '\\' '/')
case "$script" in
    /*|[A-Za-z]:/*) ;;
    *) script="$root/$script" ;;
esac

case "$script" in
    *.py)
        # shellcheck source=lib/python.sh
        . "$root/lib/python.sh"
        if ! find_python; then
            echo "multi-agent-herdr: Python 3.9+ not found (python3, python or py);" \
                "$(basename "$script") skipped" >&2
            [ -n "$hook" ] && exit 0
            exit 127
        fi
        exec "$PY" "$script" "$@" ;;
    *.sh) exec bash "$script" "$@" ;;
    *) exec "$script" "$@" ;;
esac
